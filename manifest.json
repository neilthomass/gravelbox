{
  "manifest_version": 3,
  "name": "Gravelbox",
  "version": "1.4.3",
  "description": "Block sites, extra tabs, and function keys; loop recorded video and audio; override location; sync Gradescope to Google Calendar.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "alarms",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Gravelbox",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/media/page-camera.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/media/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "*://*.gradescope.com/*"
      ],
      "js": [
        "vendor/browser-polyfill.js",
        "src/gradescope/utils/browserDetector.js",
        "src/gradescope/utils/dateParser.js",
        "src/gradescope/utils/assignmentParser.js",
        "src/gradescope/utils/pageDetector.js",
        "src/gradescope/contentScript.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/location/page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/location/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "oauth2": {
    "client_id": "589515007396-0frm2bh6mhobpqiuec8p2dlb2gs10gla.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar"
    ]
  }
}
